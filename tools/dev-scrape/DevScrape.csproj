<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console tool for the home PC: scrapes the TCG stores with dev-client's clients and uploads the result to the API.
       Not part of the bot (DevBot.csproj excludes tools\**) and not built by the Railway images. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DevScrape</AssemblyName>
    <RootNamespace>DevScrape</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\dev-client\DevClient.csproj" />
  </ItemGroup>

</Project>
